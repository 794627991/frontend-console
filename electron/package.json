{
  "name": "frontend-console-shell",
  "version": "0.1.0",
  "private": true,
  "description": "前端控制台 Electron 壳（P1/P2/P3）——拉起 Python 后端 sidecar 并承载 web UI",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": {
    "name": "HG"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.hg.frontend-console",
    "productName": "前端控制台",
    "directories": {
      "output": "../dist/electron_setup"
    },
    "files": [
      "main.js",
      "preload.js",
      "guest-preload.js",
      "passwords.js",
      "pw-ipc.js"
    ],
    "extraResources": [
      {
        "from": "../dist/前端控制台",
        "to": "backend"
      }
    ],
    "asar": true,
    "win": {
      "icon": "../ico/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "前端控制台",
      "artifactName": "前端控制台-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
