# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# PyInstaller 构建产物（锚定根目录——裸 dist/ 会把 vendor/**/dist 前端
# 构建产物一并吞掉，markdown-it.min.js 因此从未入库，源码 clone 下来
# md 预览必 404，用户实锤）
/build/
/dist/
*.spec.bak

# 串口日志（运行时生成，不入库）
serial_logs/

# 运行时状态文件
endpoint.json
~/.serialconsole_pro/

# 临时调试文件
_debug_raw.log
分段版本/

# 第三方参考资源（ImHex 源码/发行版——本地参考用，不入库）
参考/

# IDE / 系统
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 编辑器本地历史快照（VSCode Local History 插件产物）
.history/

# 用户数据（命令库跟工具目录走，但属用户数据不进版本库）
cmdlib.json
idx/

# 用户笔记/图片（工具运行时用户创建，属用户数据不进版本库）
files/

# 数据目录（运行时生成：日志/笔记/命令库/WebView 缓存，全用户数据不入库）
data/
参考/
.data/
_engine_stdio_ext/

# 第三方参考代码（375MB，含他人 api_key 等——绝不入库）
参考/

# 本地工作截图（会话用图，不入库）
png/

# markdown-it npm 源码包的本地散件（运行时只用 dist/markdown-it.min.js，已入库；
# 这俩无任何引用，不入库只做本地忽略——vendor 源码包完整性留给本地盘）
/vendor/markdown-it/dist/markdown-it.js
/vendor/markdown-it/dist/index.cjs.js

# v2.3.7b WebView2 内置运行时【入库随仓走——铁律：任何机器无条件可打包，零网络】
# （只忽略 fetch 脚本的 cab 残件；WebView2Fixed/ 本体 git 跟踪）
/runtime/*.cab

# v4.1：离线资源包解包落点（WebView2 Fixed Version 等，运行时生成，几百 MB 不入库）
/offline_runtime/

# ---- 仓库瘦身（D 批）：.ua 产物库出库（用户拍板：vendor 不瘦身，保持原样）----
# 代码分析工具 .ua 的产物库（knowledge-graph/.trash 中间产物——本地工具数据，不入库）
/.ua/
src/_fcpk_key.py

# ZCode 会话工作区（计划/临时脚本/验证产物，本地工具数据，不入库）
/.zcode/
# a326：离线资源统一目录（本体不入库，仅清单入库）
/offline_assets/*
!/offline_assets/MANIFEST.json
# a326 起 onlyoffice 装在 offline_assets/onlyoffice/（旧 vendor/onlyoffice 已迁空）
# a348R：该空壳目录仅剩 `.download-ok` 下载标记，被 `git add -A` 误纳入过一次；
# 显式忽略，防止残留标记再次进库。
/vendor/onlyoffice/

# 代码索引/设计稿：本地工具数据，不入库（用户令 a592）
/.codegraph/
/design/

# 前端 JS 工具链依赖（npm install 生成，不入库）
/tools/js-tooling/node_modules/

# JS 工具链生成物。app-globals.json 例外——它是 lint 的必需输入（51KB），
# 入库才能让「克隆下来直接跑 lint」成立；其余都能由 tools/ 下脚本重生成。
/tests/js/eslint-raw.json
/tests/js/loaded.txt
/tests/js/orphans.txt


# 回归测试运行产物（截图/临时日志不入库；保留 .gitkeep）
tests/regression/artifacts/*
!tests/regression/artifacts/.gitkeep
tests/regression/__pycache__/

# 测试落盘根（2026-11-26 用户令：测试不得在 C 盘留任何文件）。沙箱、临时
# 文件、pytest 的 tmp_path、门禁日志都落这里，见 app_state._fc_test_isolation。
# 可随时整个删除。
/.temp/
