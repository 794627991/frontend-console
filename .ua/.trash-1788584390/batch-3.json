    {
      "id": "file:src/log_index.py",
      "type": "file",
      "name": "log_index.py",
      "filePath": "src/log_index.py",
      "summary": "日志行偏移索引，支撑 G 级日志文件随机访问：LogIndex 首次扫描记录每行起始字节偏移并缓存到工具目录 idx/ 下的 .idx 文件（文件名含绝对路径 md5 防同名冲突），文件追加后增量续扫；提供按行号分页、大小写不敏感搜索（含 | 分隔的正则排除模式与命中行号索引）、按时间戳二分定位的回放寻址，以及按 atime 清理陈旧索引的入口。",
      "tags": ["索引", "日志分析", "随机访问", "缓存", "性能优化"],
      "complexity": "complex",
      "languageNotes": "大文件性能工程范例：行偏移用大端 struct.pack 的二进制 .idx 缓存、追加检测靠 _built_size 快照、命中行号收进 array('Q')（每命中 8 字节）实现 O(1) 按命中序号取段、ts 列表用 array('q') 填充成单调非降以支持二分。"
    },
    {
      "id": "class:src/log_index.py:LogIndex",
      "type": "class",
      "name": "LogIndex",
      "filePath": "src/log_index.py",
      "lineRange": [10, 315],
      "summary": "单个日志文件的行偏移索引器：build() 首次全扫缓存 .idx、文件追加时 _append_scan 增量续扫（截断守卫：偏移超 EOF 则全量重扫）；get_page 按行号 O(1) seek 取页；search 支持大小写不敏感 + 排除模式，全量扫描时把命中行号收进 _hits_by_q 缓存，search_page 据此按命中序号 O(1) 取段；ts_list/seek_ts 供回放按时间戳二分定位。",
      "tags": ["索引", "日志分析", "缓存", "搜索", "数据结构"],
      "complexity": "complex"
    },
    {
      "id": "function:src/log_index.py:cleanup_stale_idx",
      "type": "function",
      "name": "cleanup_stale_idx",
      "filePath": "src/log_index.py",
      "lineRange": [318, 344],
      "summary": "服务启动时清理 idx/ 下超过 max_age_days（默认 3 天）未使用的 .idx 索引文件；atime 由 _touch_idx 在命中时维护，atime/mtime 取大防误删。",
      "tags": ["清理", "缓存管理", "启动任务"],
      "complexity": "simple"
    }
