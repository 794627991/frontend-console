{
  "nodes": [
    {
      "id": "file:src/ansi_utils.py",
      "type": "file",
      "name": "ansi_utils.py",
      "filePath": "src/ansi_utils.py",
      "summary": "ANSI 转义序列处理工具模块（从 web 版迁移保持一致），提供剥离 ANSI、ANSI 转 HTML 着色、终端全屏应用检测正则以及内核/U-Boot 日志行分类等纯函数，无外部依赖，被连接基层与 AI 路由调用。",
      "tags": ["utility", "ansi", "terminal", "serialization", "log-classification"],
      "complexity": "moderate",
      "languageNotes": "用模块级预编译正则（re.VERBOSE）和惰性初始化的 256 色调色板缓存实现高性能 ANSI 解析。"
    },
    {
      "id": "function:src/ansi_utils.py:_color256",
      "type": "function",
      "name": "_color256",
      "filePath": "src/ansi_utils.py",
      "lineRange": [34, 51],
      "summary": "惰性构建并缓存 xterm 256 色调色板（16 标准色 + 216 立方色 + 24 灰阶），按索引返回对应 #RRGGBB 颜色值。",
      "tags": ["utility", "color-palette", "lazy-init", "terminal"],
      "complexity": "simple"
    },
    {
      "id": "function:src/ansi_utils.py:strip_ansi",
      "type": "function",
      "name": "strip_ansi",
      "filePath": "src/ansi_utils.py",
      "lineRange": [53, 54],
      "summary": "用预编译正则剥离文本中的全部 ANSI 转义序列（CSI、OSC、字符集切换及控制字符），返回纯净文本。",
      "tags": ["utility", "ansi", "text-cleanup", "serialization"],
      "complexity": "simple"
    },
    {
      "id": "function:src/ansi_utils.py:ansi_to_html",
      "type": "function",
      "name": "ansi_to_html",
      "filePath": "src/ansi_utils.py",
      "lineRange": [56, 119],
      "summary": "逐字符解析 ANSI SGR 颜色/样式码（含 256 色扩展），生成带内联 style 的 span 标签 HTML，并对文本做 HTML 转义，用于后端日志回看的网页渲染。",
      "tags": ["utility", "ansi", "html", "color", "serialization"],
      "complexity": "complex",
      "languageNotes": "手写状态机解析 SGR 参数序列，用 span 栈保证样式开闭配对。"
    },
    {
      "id": "function:src/ansi_utils.py:classify_line",
      "type": "function",
      "name": "classify_line",
      "filePath": "src/ansi_utils.py",
      "lineRange": [121, 134],
      "summary": "按内容特征把一行终端日志分类为 kernel_err/kernel/uboot/heop/prompt/text 等标签，供日志着色与 AI 感知过滤使用。",
      "tags": ["utility", "log-classification", "bsp", "pattern-matching"],
      "complexity": "simple"
    },
    {
      "id": "file:src/base_conn.py",
      "type": "file",
      "name": "base_conn.py",
      "filePath": "src/base_conn.py",
      "summary": "串口/SSH 连接的通用基类层：定义 BaseConnection 模板类，负责环形行缓冲、SSE 客户端分发、日志落盘、行切分、全屏应用检测与断线重连调度，IO 细节（_io_* 方法）由串口/SSH 子类实现。",
      "tags": ["data-model", "service", "buffer", "sse", "logging"],
      "complexity": "complex",
      "languageNotes": "模板方法模式：基类用 NotImplementedError 声明 IO 抽象层，_reader_loop 通用读循环驱动子类实现。"
    },
    {
      "id": "class:src/base_conn.py:BaseConnection",
      "type": "class",
      "name": "BaseConnection",
      "filePath": "src/base_conn.py",
      "lineRange": [16, 297],
      "summary": "连接基类：持有 20 万行环形 buf、SSE 客户端队列、命令历史与日志句柄；_reader_loop 读循环完成全屏检测、raw 流推送、UTF-8 增量解码与 \\n/\\r 行切分入 buf/日志，并提供缓冲区检索、关键字搜索、发送命令、重连与生命周期管理（start/close）。",
      "tags": ["base-class", "buffer", "sse", "reader-loop", "reconnect"],
      "complexity": "complex",
      "languageNotes": "细粒度锁分离（buf_lock/clients_lock/log_lock）避免读写互阻；UTF-8 增量解码器防止跨 chunk 多字节字符被截断。"
    },
    {
      "id": "file:src/serial_conn.py",
      "type": "file",
      "name": "serial_conn.py",
      "filePath": "src/serial_conn.py",
      "summary": "物理串口连接实现：SerialPort 继承 BaseConnection，用 pyserial 实现 IO 层（打开/读尽 in_waiting/写/关/重连），并提供 list_ports 枚举系统可用 COM 口。",
      "tags": ["service", "serial", "pyserial", "io-layer"],
      "complexity": "moderate",
      "languageNotes": "读循环一次读尽 in_waiting 字节合并为大块推 SSE，减少前端 term.write 次数以缓解输入卡顿。"
    },
    {
      "id": "class:src/serial_conn.py:SerialPort",
      "type": "class",
      "name": "SerialPort",
      "filePath": "src/serial_conn.py",
      "lineRange": [9, 61],
      "summary": "pyserial 串口连接类：以 timeout=0.02 打开 COM 口，_io_read_chunk 一次读尽缓冲提升吞吐，线程锁保护句柄切换，重连时先关旧句柄再重建。",
      "tags": ["serial", "io-layer", "pyserial", "thread-safe"],
      "complexity": "simple"
    },
    {
      "id": "function:src/serial_conn.py:list_ports",
      "type": "function",
      "name": "list_ports",
      "filePath": "src/serial_conn.py",
      "lineRange": [64, 68],
      "summary": "枚举系统全部可用串口，返回 device/description/hwid 字段列表，供前端串口选择下拉框使用。",
      "tags": ["utility", "serial", "enumeration", "hardware"],
      "complexity": "simple"
    },
    {
      "id": "file:src/ssh_conn.py",
      "type": "file",
      "name": "ssh_conn.py",
      "filePath": "src/ssh_conn.py",
      "summary": "SSH 连接实现：SSHConnection 继承 BaseConnection，用 paramiko 交互式 shell（invoke_shell）提供 PTY，含延迟导入 paramiko、keepalive 心跳线程与断线指数退避重连，对前端与串口连接完全透明。",
      "tags": ["service", "ssh", "paramiko", "io-layer", "keepalive"],
      "complexity": "moderate",
      "languageNotes": "paramiko 作为可选依赖延迟导入并缓存（None/False/模块 三态），纯串口场景可省约 300ms 启动时间。"
    },
    {
      "id": "function:src/ssh_conn.py:_get_paramiko",
      "type": "function",
      "name": "_get_paramiko",
      "filePath": "src/ssh_conn.py",
      "lineRange": [12, 23],
      "summary": "惰性导入 paramiko 并用模块级变量缓存结果：已加载直接返回，导入失败标记 False 避免重复尝试，返回 None 表示未安装。",
      "tags": ["utility", "lazy-import", "ssh", "optional-dependency"],
      "complexity": "simple"
    },
    {
      "id": "class:src/ssh_conn.py:SSHConnection",
      "type": "class",
      "name": "SSHConnection",
      "filePath": "src/ssh_conn.py",
      "lineRange": [25, 134],
      "summary": "paramiko SSH 连接类：AutoAddPolicy + 密码/密钥认证建立 SSHClient，invoke_shell 开 PTY 匹配嵌入式设备 dropbear 场景；select 非阻塞读，30s keepalive 防 NAT 断连，断线后按 1s/2s/4s…上限 60s 指数退避重连。",
      "tags": ["ssh", "paramiko", "keepalive", "reconnect", "io-layer"],
      "complexity": "complex",
      "languageNotes": "keepalive 优先用 paramiko 2.10+ 的 send_ignore，旧版回退到 global_request(\"keepalive@openssh.com\")。"
    }
  ],
